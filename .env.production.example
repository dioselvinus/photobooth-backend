APP_ENV=production
PORT=8080

# Public base domain (no scheme, no /s path). HTTPS terminated by reverse proxy.
BASE_DOMAIN=photos.example.com

# External Postgres (Transaction pooler on port 6543 for app runtime)
DATABASE_URL=postgres://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Direct Postgres / Session Pooler (Port 5432 for migrations)
DIRECT_DATABASE_URL=postgres://postgres:[pass]@db.[ref].supabase.co:5432/postgres?sslmode=require

# Email Configuration (resend, sendgrid, mailgun, smtp)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key_here

# Object Storage Single Source of Truth (SSOT) Configuration (Cloudflare R2 / AWS S3 / MinIO)
STORAGE_PROVIDER=r2
S3_ENDPOINT=https://cd6f73f75b62217b4290858f707438a9.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=your_access_key_here
S3_SECRET_KEY=your_secret_key_here
S3_BUCKET=photobooth
